<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- aplicar estilos públicos para que los productos en el admin se vean igual -->
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="~/css/admin.css" />
    <title>CRUD Catálogo - Admin</title>
</head>
<body class="min-h-screen">
    <div class="container mx-auto p-4">
        <header class="header mb-4">
            <div class="container header-content">
                <h1 class="header-title">Administración del Catálogo</h1>
            </div>
        </header>

        <main class="main-content">
            <div class="section-header text-center mb-2">
                <h2>Productos</h2>
                <p class="text-muted">Agrega, edita o elimina productos</p>
            </div>
            <div class="flex justify-end mb-4">
                <button class="btn btn-primary" onclick="openModal()">Agregar producto</button>
            </div>
            <div id="catalogo" class="grid grid-cols-3 gap-6"></div>
        </main>
    </div>

    <!-- modal de edición/creación -->
    <div id="modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
        <!-- card-style container for modal -->
        <div class="card w-80 relative">
            <button class="absolute top-2 right-2 text-gray-500 text-xl" onclick="closeModal()">&times;</button>
            <div class="card-content p-6">
                <h2 id="modalTitle" class="text-xl font-semibold mb-4 text-center">Editar producto</h2>
                <div class="text-center">
                    <img id="modalImagePreview" src="" alt="Imagen producto" class="mx-auto mb-4 w-32 h-32 object-cover rounded" />
                </div>
                <form id="modalForm" class="space-y-3">
                    <input type="hidden" id="modalId">
                    <div>
                        <label class="block text-sm font-medium">Nombre</label>
                        <input type="text" id="modalNombre" class="mt-1 block w-64 border border-gray-300 rounded px-2 py-1" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium">ID Categoría</label>
                        <input type="number" id="modalCategoria" class="mt-1 block w-64 border border-gray-300 rounded px-2 py-1" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium">Descripción</label>
                        <textarea id="modalDescripcion" class="mt-1 block w-64 border border-gray-300 rounded px-2 py-1"></textarea>
                    </div>
                    <div class="flex gap-4">
                        <div class="flex-1">
                            <label class="block text-sm font-medium">Precio</label>
                            <input type="number" id="modalPrecio" step="0.01" class="mt-1 block w-28 border border-gray-300 rounded px-2 py-1" required>
                        </div>
                        <div class="flex-1">
                            <label class="block text-sm font-medium">Stock</label>
                            <input type="number" id="modalStock" step="1" class="mt-1 block w-28 border border-gray-300 rounded px-2 py-1" required>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium">Imagen URL</label>
                        <input type="text" id="modalImagen" class="mt-1 block w-64 border border-gray-300 rounded px-2 py-1">
                    </div>
                    <div class="flex justify-end gap-2">
                        <button type="button" class="btn btn-ghost" onclick="closeModal()">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
    const apiUrl = "http://localhost:5027/api/Catalogo";

    async function cargarProductos() {
        try {
            const res = await fetch(apiUrl);
            const data = await res.json();
            const contenedor = document.getElementById("catalogo");
            contenedor.innerHTML = "";
            if (data.length === 0) {
                contenedor.innerHTML = `<div class="empty-state text-center"><p class="text-muted">No hay productos</p></div>`;
                return;
            }
            data.forEach(p => {
                const card = document.createElement("div");
                card.className = "card overflow-hidden transition-all";
                card.innerHTML = `
                    <div class="aspect-video overflow-hidden">
                        <img
                            src="${p.imagen || 'https://via.placeholder.com/400x300?text=Sin+Imagen'}"
                            alt="${p.nombreProducto}"
                            class="product-image w-full h-full object-cover">
                    </div>
                    <div class="card-content space-y-3">
                        <div class="flex justify-between items-center">
                            <h4 class="truncate">${p.nombreProducto}</h4>
                            <span class="badge badge-primary">${p.categoria?.nombreCategoria || ''}</span>
                        </div>
                        <p class="text-sm text-muted truncate">${p.descripcion || ''}</p>
                        <div class="flex justify-between items-center mt-2">
                            <span class="text-primary text-2xl">$${p.precio.toFixed(2)}</span>
                        </div>
                        <div class="flex justify-center gap-2 mt-3">
                            <button class="btn btn-sm btn-ghost" onclick="eliminarProducto(${p.idProducto})">Eliminar</button>
                            <button class="btn btn-sm btn-primary" onclick="editarProducto(${p.idProducto})">Editar</button>
                        </div>
                    </div>`;
                contenedor.appendChild(card);
            });
        } catch (err) {
            console.error(err);
            document.getElementById("catalogo").innerHTML = "<p>Error cargando productos</p>";
        }
    }

    function openModal(editar = false) {
        const modal = document.getElementById("modal");
        modal.classList.remove("hidden");
        if (!editar) {
            document.getElementById("modalTitle").textContent = "Crear producto";
            document.getElementById("modalForm").reset();
            document.getElementById("modalId").value = "";
            document.getElementById("modalImagePreview").src = "https://via.placeholder.com/128";
        }
    }

    function closeModal() {
        document.getElementById("modal").classList.add("hidden");
    }

    document.getElementById("modalForm").addEventListener("submit", async e => {
        e.preventDefault();
        const id = document.getElementById("modalId").value;
        const producto = {
            IdProducto: id || 0,
            NombreProducto: document.getElementById("modalNombre").value,
            IdCategoria: parseInt(document.getElementById("modalCategoria").value),
            Descripcion: document.getElementById("modalDescripcion").value,
            Precio: parseFloat(document.getElementById("modalPrecio").value),
            Stock: parseInt(document.getElementById("modalStock").value),
            Imagen: document.getElementById("modalImagen").value
        };
        try {
            if (id) {
                await fetch(`${apiUrl}/${id}`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify(producto) });
            } else {
                await fetch(apiUrl, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(producto) });
            }
            closeModal();
            cargarProductos();
        } catch (err) { console.error(err); }
    });

    async function editarProducto(id) {
        console.log("editarProducto called with id:", id);
        try {
            const res = await fetch(`${apiUrl}/${id}`);
            const p = await res.json();
            console.log("Producto fetched:", p);
            document.getElementById("modalTitle").textContent = "Editar producto";
            document.getElementById("modalId").value = p.idProducto;
            document.getElementById("modalNombre").value = p.nombreProducto;
            document.getElementById("modalCategoria").value = p.idCategoria;
            document.getElementById("modalDescripcion").value = p.descripcion;
            document.getElementById("modalPrecio").value = p.precio;
            document.getElementById("modalStock").value = p.stock || 0;
            document.getElementById("modalImagen").value = p.imagen || '';
            document.getElementById("modalImagePreview").src = p.imagen || 'https://via.placeholder.com/128';
            openModal(true);
        } catch (err) { console.error("Error en editarProducto:", err); }
    }

    async function eliminarProducto(id) {
        if (confirm("¿Deseas eliminar este producto?")) {
            try {
                await fetch(`${apiUrl}/${id}`, { method: "DELETE" });
                cargarProductos();
            } catch (err) { console.error(err); }
        }
    }

    cargarProductos();
    </script>
</body>
</html>